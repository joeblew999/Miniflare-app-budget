{
  "name": "baht-dollar-budget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "cli": "node cli/main.ts",
    "app:setup": "wireit",
    "app:dev": "wireit",
    "app:verify": "wireit",
    "app:artifact": "wireit",
    "app:smoke": "wireit",
    "app:preview": "wireit",
    "app:build": "wireit",
    "worker:ci": "wireit",
    "worker:preview": "wireit",
    "worker:deploy": "wireit",
    "worker:setup": "wireit",
    "worker:build": "wireit",
    "worker:status": "wireit",
    "worker:logs": "wireit",
    "db:gen": "wireit",
    "ui:add": "wireit",
    "theme:set": "wireit"
  },
  "wireit": {
    "worker:types": {
      "command": "node cli/main.ts worker types",
      "files": [
        "wrangler.jsonc"
      ],
      "output": [
        "worker-configuration.d.ts"
      ]
    },
    "app:check": {
      "command": "node cli/main.ts app check",
      "dependencies": [
        "worker:types"
      ],
      "files": [
        "src/**",
        "shared/**",
        "worker/**",
        "cli/**",
        "artifact/**",
        "index.html",
        "tsconfig*.json",
        "vite.config.ts",
        "vite.artifact.config.ts",
        "vitest.config.ts",
        "drizzle.config.ts",
        "worker-configuration.d.ts"
      ],
      "output": []
    },
    "app:lint": {
      "command": "node cli/main.ts app lint",
      "files": [
        "src/**",
        "shared/**",
        "worker/**",
        "cli/**",
        "artifact/**",
        ".oxlintrc.json"
      ],
      "output": []
    },
    "test:run": {
      "command": "node cli/main.ts test run",
      "dependencies": [
        "worker:types"
      ],
      "files": [
        "worker/**",
        "shared/**",
        "migrations/**",
        "vitest.config.ts",
        "wrangler.jsonc",
        "fnox.toml"
      ],
      "output": []
    },
    "db:migrate": {
      "command": "node cli/main.ts db migrate"
    },
    "docs:gen": {
      "command": "node cli/main.ts docs gen",
      "files": [
        "package.json",
        "cli/**",
        "**/*.md",
        "src/**",
        "shared/**",
        "worker/**",
        "artifact/**",
        "*.ts",
        "*.html",
        "*.jsonc",
        "*.toml",
        "!plans/**",
        "!node_modules/**",
        "!dist/**"
      ],
      "output": []
    },
    "app:setup": {
      "command": "node cli/main.ts app setup"
    },
    "app:dev": {
      "command": "node cli/main.ts app dev",
      "service": true,
      "dependencies": [
        "db:migrate"
      ]
    },
    "app:verify": {
      "dependencies": [
        "app:check",
        "test:run",
        "app:lint",
        "docs:gen"
      ]
    },
    "app:artifact": {
      "command": "node cli/main.ts app artifact",
      "dependencies": [
        "app:check"
      ]
    },
    "app:smoke": {
      "command": "node cli/main.ts app smoke"
    },
    "app:build": {
      "command": "node cli/main.ts app build",
      "dependencies": [
        "app:check"
      ]
    },
    "app:preview": {
      "command": "node cli/main.ts app preview",
      "service": true,
      "dependencies": [
        "app:build",
        "db:migrate"
      ]
    },
    "worker:ci": {
      "command": "node cli/main.ts worker ci"
    },
    "worker:preview": {
      "command": "node cli/main.ts worker preview"
    },
    "worker:deploy": {
      "command": "node cli/main.ts worker deploy",
      "dependencies": [
        "app:verify",
        "app:build"
      ]
    },
    "worker:setup": {
      "command": "node cli/main.ts worker setup"
    },
    "worker:build": {
      "command": "node cli/main.ts worker build"
    },
    "worker:status": {
      "command": "node cli/main.ts worker status"
    },
    "worker:logs": {
      "command": "node cli/main.ts worker logs"
    },
    "db:gen": {
      "command": "node cli/main.ts db gen"
    },
    "ui:add": {
      "command": "node cli/main.ts ui add"
    },
    "theme:set": {
      "command": "node cli/main.ts theme set"
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@orpc/client": "2.0.0-beta.43",
    "@orpc/contract": "2.0.0-beta.43",
    "@orpc/json-schema": "2.0.0-beta.43",
    "@orpc/openapi": "2.0.0-beta.43",
    "@orpc/server": "2.0.0-beta.43",
    "@orpc/tanstack-query": "2.0.0-beta.43",
    "@orpc/zod": "2.0.0-beta.43",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.81.0",
    "playwright-core": "1.56.1",
    "shadcn": "^4.21.5",
    "sql.js": "^1.15.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12",
    "wireit": "0.14.13",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
